# Copy to .env and adjust values for local development.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/siteproof?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# JWT
JWT_SECRET=change-me-to-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=siteproof

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=10s

# Postmark (email)
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=tickets@siteproof.app
POSTMARK_FROM_NAME=SiteProof
POSTMARK_TIMEOUT=5s

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TIMEOUT=5s

# OAuth (Microsoft)
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_MICROSOFT_REDIRECT_URL=
OAUTH_MICROSOFT_SCOPES=openid,profile,email

# Storage
STORAGE_BASE_PATH=/data/uploads
STORAGE_MAX_FILE_SIZE=10485760
